{
  "name": "portfolio-bi-dashboard-hospitalar",
  "version": "1.0.0",
  "description": "Dashboard Hospitalar de Business Intelligence - Portfólio Wellington Lima",
  "author": "Wellington de Lima Catarina <lelolima806@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "pytest tests/ -v",
    "test:cov": "pytest tests/ -v --cov=src/web --cov-report=html",
    "lint": "flake8 src/ tests/ --max-line-length=100",
    "format": "black src/ tests/ && isort src/ tests/",
    "format:check": "black --check src/ tests/",
    "typecheck": "mypy src/ --ignore-missing-imports",
    "quality": "npm run lint && npm run format:check",
    "check": "npm run quality && npm run test",
    "dev": "streamlit run src/web/app.py",
    "build:docker": "docker build -t dashboard-hospitalar:latest .",
    "run:docker": "docker run -p 8501:8501 dashboard-hospitalar:latest",
    "deploy:streamlit": "echo 'Push to main branch to trigger Streamlit Cloud deploy'",
    "etl": "python src/etl/pacientes_etl.py"
  },
  "keywords": [
    "power-bi",
    "business-intelligence",
    "healthcare",
    "dashboard",
    "streamlit",
    "data-analytics",
    "python",
    "portfolio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Lelolima/portfolio-bi-wellington-lima.git"
  },
  "bugs": {
    "url": "https://github.com/Lelolima/portfolio-bi-wellington-lima/issues"
  },
  "homepage": "https://github.com/Lelolima/portfolio-bi-wellington-lima#readme",
  "devDependencies": {
    "pytest": ">=7.4.0",
    "pytest-cov": ">=4.1.0",
    "black": ">=23.7.0",
    "flake8": ">=6.1.0",
    "isort": ">=5.12.0",
    "mypy": ">=1.5.0"
  },
  "dependencies": {
    "streamlit": ">=1.30.0",
    "pandas": ">=2.0.0",
    "plotly": ">=5.17.0",
    "numpy": ">=1.24.0"
  }
}